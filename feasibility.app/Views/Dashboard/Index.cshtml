@using feasibility.Entity.Dtos.FeasibilityAmortization
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
    var recentFeasibilities = ViewBag.RecentFeasibilities as List<FeasibilityAmortizationListDto> ?? new();
    int feasibilityCount = ViewBag.FeasibilityCount ?? 0;
    int userCount = ViewBag.UserCount ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/dashboard.css" />
}

<div class="page-header">
    <div>
        <h1>Dashboard</h1>
        <p>Sistemdeki genel istatistikler.</p>
    </div>
</div>

<div class="dash-stats">
    <a href="/FeasibilityAmortization/Index" class="dash-stat">
        <div class="dash-stat-icon"><span class="material-symbols-outlined">calculate</span></div>
        <div>
            <span class="dash-stat-label">Fizibilite</span>
            <span class="dash-stat-value">@feasibilityCount</span>
        </div>
    </a>
    <a href="/User/Index" class="dash-stat">
        <div class="dash-stat-icon"><span class="material-symbols-outlined">group</span></div>
        <div>
            <span class="dash-stat-label">Kullanıcı</span>
            <span class="dash-stat-value">@userCount</span>
        </div>
    </a>
    <a href="/ActivityLog/Index" class="dash-stat">
        <div class="dash-stat-icon"><span class="material-symbols-outlined">history</span></div>
        <div>
            <span class="dash-stat-label">Aktivite Logları</span>
            <span class="dash-stat-value">Görüntüle</span>
        </div>
    </a>
</div>

<div class="card" style="margin-top:24px;">
    <div class="card-header">
        <h2>Son Eklenen Fizibiliteler</h2>
        <a href="/FeasibilityAmortization/Index" class="btn btn-ghost btn-sm">Tümünü Gör</a>
    </div>
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Fizibilite Adı</th>
                    <th>Versiyon</th>
                    <th>Lokasyon</th>
                    <th class="text-right">Toplam Yatırım ($)</th>
                    <th>Durum</th>
                    <th>Oluşturan</th>
                    <th>Tarih</th>
                    <th style="text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!recentFeasibilities.Any())
                {
                    <tr><td colspan="8"><div class="empty-state"><span class="material-symbols-outlined">calculate</span>Henüz fizibilite eklenmemiş.</div></td></tr>
                }
                @foreach (var item in recentFeasibilities)
                {
                    <tr>
                        <td><strong>@item.FeasibilityName</strong></td>
                        <td><span class="badge badge-info">v@item.Version</span></td>
                        <td title="@item.LocationName">@(string.IsNullOrWhiteSpace(item.LocationName) ? "-" : item.LocationName)</td>
                        <td class="text-right">$ @item.TotalInvestmentUsd.ToString("#,##0", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</td>
                        <td>
                            @if (item.IsDeleted)
                            {
                                <span class="badge badge-passive">Pasif</span>
                            }
                            else
                            {
                                <span class="badge badge-active">Aktif</span>
                            }
                        </td>
                        <td>@(item.CreatedByName ?? "-")</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <div class="row-actions" style="justify-content:flex-end;">
                                <a href="/FeasibilityAmortization/View/@item.Id" class="row-action-btn">
                                    <span class="material-symbols-outlined">visibility</span> Görüntüle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
