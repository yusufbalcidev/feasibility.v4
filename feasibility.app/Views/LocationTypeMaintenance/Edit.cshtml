@model LocationTypeMaintenanceUpdateDto
@{
    ViewData["Title"] = "Lokasyon Bakım Tipi Düzenle";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
    var audit = ViewBag.Audit as AuditInfoDto;
}

@section Styles {
    <link rel="stylesheet" href="~/css/locationtypemaintenance/edit/style.css" />
}

<div class="page-header">
    <div>
        <h1>Tip Düzenle</h1>
        <p><strong>@Model.Name</strong></p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <span class="material-symbols-outlined">arrow_back</span> Geri
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="form">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Name">Tip Adı *</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Açıklama</label>
                <textarea asp-for="Description" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">save</span> Güncelle
                </button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@if (audit != null)
{
    <partial name="_AuditPartial" model="audit" />
}
