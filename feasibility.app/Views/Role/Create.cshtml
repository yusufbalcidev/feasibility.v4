@model RoleCreateDto
@{
    ViewData["Title"] = "Yeni Rol";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/role/create/style.css" />
}

<div class="page-header">
    <div>
        <h1>Yeni Rol</h1>
        <p>Yeni rol oluşturun ve sayfa yetkilerini belirleyin.</p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <span class="material-symbols-outlined">arrow_back</span> Geri
        </a>
    </div>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="card">
        <div class="card-body">
            <div class="form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Name">Rol Adı *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description">Açıklama</label>
                    <textarea asp-for="Description" rows="2"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>
            </div>
        </div>
    </div>

    <partial name="_PermissionsPartial" model="Model.Permissions" />

    <div class="form-actions" style="margin-top:16px;">
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined">save</span> Kaydet
        </button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/role/edit/script.js"></script>
}
