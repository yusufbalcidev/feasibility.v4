@model RoleUpdateDto
@{
    ViewData["Title"] = "Rol Düzenle";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
    var audit = ViewBag.Audit as AuditInfoDto;
    bool isSystem = ViewBag.IsSystem ?? false;
}

@section Styles {
    <link rel="stylesheet" href="~/css/role/edit/style.css" />
}

<div class="page-header">
    <div>
        <h1>Rol Düzenle</h1>
        <p><strong>@Model.Name</strong>@(isSystem ? " (Sistem rolü - sadece yetkiler güncellenebilir)" : "")</p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn btn-secondary">
            <span class="material-symbols-outlined">arrow_back</span> Geri
        </a>
    </div>
</div>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />

    <div class="card">
        <div class="card-body">
            <div class="form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Name">Rol Adı *</label>
                    <input asp-for="Name" class="form-control" readonly="@isSystem" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description">Açıklama</label>
                    <textarea asp-for="Description" rows="2" readonly="@isSystem"></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>
            </div>
        </div>
    </div>

    <partial name="_PermissionsPartial" model="Model.Permissions" />

    <div class="form-actions" style="margin-top:16px;">
        <button type="submit" class="btn btn-primary">
            <span class="material-symbols-outlined">save</span> Güncelle
        </button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>

@if (audit != null)
{
    <partial name="_AuditPartial" model="audit" />
}

@section Scripts {
    <script src="~/js/role/edit/script.js"></script>
}
