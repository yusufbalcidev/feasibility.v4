@model PagedResult<RoleListDto>
@{
    ViewData["Title"] = "Roller";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/role/index/style.css" />
}

<div class="page-header">
    <div>
        <h1>Roller</h1>
        <p>Sistem rollerini ve sayfa yetkilerini yönetin.</p>
    </div>
    <div class="header-actions">
        <a asp-action="Create" class="btn btn-primary">
            <span class="material-symbols-outlined">shield_person</span> Yeni Rol
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2>Rol Listesi</h2>
        <span class="badge badge-info">@Model.TotalCount kayıt</span>
    </div>
    <div class="card-header list-toolbar">
        @await Html.PartialAsync("_SearchBar", Model.Search, new ViewDataDictionary(ViewData) { { "Placeholder", "Rol adı veya açıklama ara..." } })
    </div>
    <div class="table-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Rol Adı</th>
                    <th>Açıklama</th>
                    <th>Kullanıcı Sayısı</th>
                    <th>Durum</th>
                    <th>Ekleyen</th>
                    <th>Oluşturma</th>
                    <th style="text-align:right;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7"><div class="empty-state"><span class="material-symbols-outlined">admin_panel_settings</span>@(string.IsNullOrWhiteSpace(Model.Search) ? "Henüz rol eklenmemiş." : $"\"{Model.Search}\" için sonuç bulunamadı.")</div></td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.Name</strong>
                            @if (item.IsSystem)
                            {
                                <span class="badge badge-warning" style="margin-left:8px;">Sistem</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</td>
                        <td>@item.UserCount</td>
                        <td>
                            @if (item.IsDeleted)
                            {
                                <span class="badge badge-passive">Pasif</span>
                            }
                            else
                            {
                                <span class="badge badge-active">Aktif</span>
                            }
                        </td>
                        <td>@(item.CreatedByName ?? "-")</td>
                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <div class="row-actions" style="justify-content:flex-end;">
                                <a asp-action="Details" asp-route-id="@item.Id" class="row-action-btn">
                                    <span class="material-symbols-outlined">visibility</span> Görüntüle
                                </a>
                                @if (!item.IsDeleted)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="row-action-btn">
                                        <span class="material-symbols-outlined">edit</span> Düzenle
                                    </a>
                                    @if (!item.IsSystem)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                              data-confirm="@item.Name rolünü silmek istediğinize emin misiniz?">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="row-action-btn danger">
                                                <span class="material-symbols-outlined">delete</span> Sil
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="@((IPagedResult)Model)" />
</div>
