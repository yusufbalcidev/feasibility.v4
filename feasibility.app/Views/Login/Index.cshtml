@model LoginDto
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EKA Enerji - Giriş Yap</title>
    <link rel="stylesheet" href="~/css/layout/site.css" />
    <link rel="stylesheet" href="~/css/login/login.css" />
    <link rel="stylesheet" href="~/lib/alertifyjs/css/alertify.min.css" />
    <link rel="icon" type="image/x-icon" href="https://ekaenerjiteknoloji.com.tr/favicon.ico" />
</head>
<body class="auth-body">
    <div class="auth-card">
        <div class="auth-logo">
            <img src="~/images/eka-logo-Photoroom.png" alt="EKA Enerji" />
        </div>
        <h1>Giriş Yap</h1>
        <p class="auth-sub">Hesabınızla devam edin</p>

        @if (TempData["Error"] is string loginError && !string.IsNullOrEmpty(loginError))
        {
            <div class="auth-alert auth-alert-error" role="alert">@loginError</div>
        }

        <form asp-action="Index" method="post" class="form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UserName">Kullanıcı Adı</label>
                <input asp-for="UserName" class="form-control" placeholder="kullanici_adi" autocomplete="username" />
                <span asp-validation-for="UserName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Şifre</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Giriş Yap</button>

            <div class="auth-foot">
                <a href="/Login/ForgotPassword">Şifremi unuttum</a>
            </div>
        </form>
    </div>

    <script src="~/lib/alertifyjs/js/alertify.min.js"></script>
    <script src="~/js/login/login.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var success = @Html.Raw(Json.Serialize(TempData["Success"] as string ?? ""));
            var error = @Html.Raw(Json.Serialize(TempData["Error"] as string ?? ""));
            if (success && window.alertify) alertify.success(success);
            if (error && window.alertify) alertify.error(error);
        });
    </script>
</body>
</html>
