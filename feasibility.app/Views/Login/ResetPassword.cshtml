@model ResetPasswordDto
@{
    Layout = null;
    ViewData["Title"] = "Yeni Şifre";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EKA Enerji - Yeni Şifre</title>
    <link rel="icon" type="image/x-icon" href="https://ekaenerjiteknoloji.com.tr/favicon.ico" />
    <link rel="stylesheet" href="~/css/layout/site.css" />
    <link rel="stylesheet" href="~/css/login/login.css" />
    <link rel="stylesheet" href="~/lib/alertifyjs/css/alertify.min.css" />
</head>
<body class="auth-body">
    <div class="auth-card">
        <div class="auth-logo"><img src="~/images/eka-logo-Photoroom.png" alt="EKA Enerji" /></div>
        <h1>Yeni Şifre</h1>
        <p class="auth-sub">Yeni şifrenizi belirleyin.</p>

        <form asp-action="ResetPassword" method="post" class="form">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="NewPassword">Yeni Şifre</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="NewPasswordConfirm">Yeni Şifre (Tekrar)</label>
                <input asp-for="NewPasswordConfirm" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="NewPasswordConfirm" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Şifremi Güncelle</button>
            <div class="auth-foot"><a href="/Login/Index">← Giriş sayfasına dön</a></div>
        </form>
    </div>

    <script src="~/lib/alertifyjs/js/alertify.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var success = '@(TempData["Success"] as string ?? "")';
            var error = '@(TempData["Error"] as string ?? "")';
            if (success) alertify.success(success);
            if (error) alertify.error(error);
        });
    </script>
</body>
</html>
