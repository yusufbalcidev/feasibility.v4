@model ForgotPasswordDto
@{
    Layout = null;
    ViewData["Title"] = "Şifremi Unuttum";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EKA Enerji - Şifremi Unuttum</title>
    <link rel="stylesheet" href="~/css/layout/site.css" />
    <link rel="stylesheet" href="~/css/login/login.css" />
    <link rel="stylesheet" href="~/lib/alertifyjs/css/alertify.min.css" />
</head>
<body class="auth-body">
    <div class="auth-card">
        <div class="auth-logo"><img src="~/images/eka-logo-Photoroom.png" alt="EKA Enerji" /></div>
        <h1>Şifre Sıfırlama</h1>
        <p class="auth-sub">Kayıtlı e-posta adresinizi girin.</p>

        <form asp-action="ForgotPassword" method="post" class="form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email">E-posta</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ornek@ekaenerji.com.tr" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-submit">Kod Gönder</button>
            <div class="auth-foot"><a href="/Login/Index">← Giriş sayfasına dön</a></div>
        </form>
    </div>

    <script src="~/lib/alertifyjs/js/alertify.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var success = '@(TempData["Success"] as string ?? "")';
            var error = '@(TempData["Error"] as string ?? "")';
            if (success) alertify.success(success);
            if (error) alertify.error(error);
        });
    </script>
</body>
</html>
