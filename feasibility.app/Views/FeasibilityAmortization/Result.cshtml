@using System.Globalization
@model feasibility.Entity.Dtos.FeasibilityAmortization.FeasibilityAmortizationDetailDto
@{
    ViewData["Title"] = Model.FeasibilityName + " — Fizibilite Sonucu";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
    var tr  = CultureInfo.GetCultureInfo("tr-TR");
    var inv = CultureInfo.InvariantCulture;
    Func<decimal, string> N0  = v => v.ToString("#,##0", tr);
    Func<decimal, string> N2  = v => v.ToString("#,##0.##", tr);
    Func<decimal, string> USD = v => "$ " + v.ToString("#,##0", tr);
    Func<decimal, string> PCT = v => "%" + v.ToString("0.0", tr);
    Func<decimal, string> RAW = v => v.ToString("0.########", inv);
    bool pos(decimal v) => v >= 0;
    string sign(decimal v) => v >= 0 ? "+" : "";

    decimal displayPayback;
    bool paybackWithinContract;
    if (Model.SunkPaybackYears > 0)
    {
        displayPayback        = Model.SunkPaybackYears;
        paybackWithinContract = true;
    }
    else if (Model.SunkAmortization.Any() && Model.SunkInvestmentUsd > 0)
    {
        var last = Model.SunkAmortization.Last();
        if (last.RemainingUsd <= 0)
        {
            displayPayback        = 0.1m;
            paybackWithinContract = true;
        }
        else if (last.NetProfitUsd > 0)
        {
            displayPayback        = Math.Round(Model.SunkAmortization.Count + (last.RemainingUsd / last.NetProfitUsd), 1);
            paybackWithinContract = false;
        }
        else
        {
            displayPayback        = Model.AnnualNetProfitUsd > 0 ? Math.Round(Model.SunkInvestmentUsd / Model.AnnualNetProfitUsd, 1) : 0m;
            paybackWithinContract = false;
        }
    }
    else if (Model.SunkInvestmentUsd > 0 && Model.AnnualNetProfitUsd > 0)
    {
        displayPayback        = Math.Round(Model.SunkInvestmentUsd / Model.AnnualNetProfitUsd, 1);
        paybackWithinContract = false;
    }
    else if (Model.PaybackYears > 0)
    {
        displayPayback        = Model.PaybackYears;
        paybackWithinContract = false;
    }
    else
    {
        displayPayback        = 0m;
        paybackWithinContract = false;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/feasibility/amortization/result/style.css" />
}

<div class="page-header">
    <div>
        <div class="crumb">Fizibiliteler &middot; Amortisman &middot; <strong>Sonuç</strong></div>
        <h1>@Model.FeasibilityName</h1>
        <p>
            @Model.LocationName &nbsp;&middot;&nbsp;
            @Model.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy", tr)
            @if (Model.CreatedByName != null) { <text>&nbsp;&middot;&nbsp; @Model.CreatedByName</text> }
        </p>
    </div>
    <div class="header-actions">
        <a href="/FeasibilityAmortization/Index" class="btn btn-secondary">
            <span class="material-symbols-outlined">arrow_back</span> Listeye Dön
        </a>
        <a href="/FeasibilityAmortization/Edit/@Model.Id" class="btn btn-secondary">
            <span class="material-symbols-outlined">edit</span> Düzenle
        </a>
        <a href="/FeasibilityAmortization/Create" class="btn btn-primary">
            <span class="material-symbols-outlined">add_chart</span> Yeni Fizibilite
        </a>
    </div>
</div>

<!-- Başarı bildirimi -->
<div class="result-success-banner" id="successBanner">
    <span class="material-symbols-outlined">check_circle</span>
    <span>Fizibilite başarıyla kaydedildi.</span>
</div>

<!-- ═══ KPI KARTLARI ══════════════════════════════════════════════════ -->
<div class="res-kpi-row">
    <!-- Toplam Yatırım -->
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon" style="background:var(--primary-50);">
                <span class="material-symbols-outlined" style="color:var(--primary);">account_balance_wallet</span>
            </div>
            <span class="res-kpi-badge" style="background:var(--primary-50);color:var(--primary);">Yatırım</span>
        </div>
        <div>
            <div class="res-kpi-value">
                <span class="js-money" data-tl="@RAW(Model.TotalInvestmentTl)" data-dec="0">@N0(Model.TotalInvestmentTl) ₺</span>
            </div>
            <div class="res-kpi-label">Toplam Yatırım</div>
        </div>
    </div>

    <!-- Amortisman Süresi -->
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon" style="background:@(paybackWithinContract ? "var(--success-50)" : "var(--warning-50)");">
                <span class="material-symbols-outlined" style="color:@(paybackWithinContract ? "var(--success)" : "var(--warning)");">schedule</span>
            </div>
            @if (!paybackWithinContract && displayPayback > 0)
            {
                <span class="res-kpi-badge" style="background:var(--warning-50);color:var(--warning);">Sözleşme Dışı</span>
            }
            else if (paybackWithinContract)
            {
                <span class="res-kpi-badge" style="background:var(--success-50);color:var(--success);">Sözleşme İçi</span>
            }
        </div>
        <div>
            <div class="res-kpi-value @(paybackWithinContract ? "pos" : "")">
                @if (displayPayback > 0)
                {
                    @displayPayback.ToString("0.0", tr)<text> Yıl</text>
                }
                else
                {
                    <span style="color:var(--text-muted);font-size:1rem;">Hesaplanamadı</span>
                }
            </div>
            <div class="res-kpi-label">Amortisman Süresi</div>
        </div>
    </div>

    <!-- Yıl 1 Net Kâr -->
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon" style="background:@(pos(Model.AnnualNetProfitTl) ? "var(--success-50)" : "var(--danger-50)");">
                <span class="material-symbols-outlined" style="color:@(pos(Model.AnnualNetProfitTl) ? "var(--success)" : "var(--danger)");">trending_up</span>
            </div>
            <span class="res-kpi-badge" style="background:var(--surface-2);color:var(--text-muted);">Yıl 1</span>
        </div>
        <div>
            <div class="res-kpi-value @(pos(Model.AnnualNetProfitTl) ? "pos" : "neg")">
                <span class="js-money" data-tl="@RAW(Model.AnnualNetProfitTl)" data-dec="0">@sign(Model.AnnualNetProfitTl)@N0(Model.AnnualNetProfitTl) ₺</span>
            </div>
            <div class="res-kpi-label">Net Kâr</div>
        </div>
    </div>

    <!-- ROI -->
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon" style="background:@(pos(Model.RoiPercent) ? "var(--primary-50)" : "var(--danger-50)");">
                <span class="material-symbols-outlined" style="color:@(pos(Model.RoiPercent) ? "var(--primary)" : "var(--danger)");">donut_large</span>
            </div>
            <span class="res-kpi-badge" style="background:var(--surface-2);color:var(--text-muted);">Yıllık</span>
        </div>
        <div>
            <div class="res-kpi-value @(pos(Model.RoiPercent) ? "pos" : "neg")">
                @sign(Model.RoiPercent)@PCT(Model.RoiPercent)
            </div>
            <div class="res-kpi-label">ROI</div>
        </div>
    </div>
</div>

<!-- ═══ YATIRIM + GERİ KAZANIM ════════════════════════════════════════ -->
<div class="res-summary-grid">
    <!-- Yatırım Dağılımı -->
    <div class="card res-section">
        <div class="res-sec-header" onclick="toggleSec(this)">
            <div class="res-sec-icon" style="background:var(--primary-50);">
                <span class="material-symbols-outlined" style="color:var(--primary);">pie_chart</span>
            </div>
            <div>
                <div class="res-sec-title">Yatırım Dağılımı</div>
                <div class="res-sec-sub">Toplam sermaye harcaması</div>
            </div>
            <span class="material-symbols-outlined res-sec-chevron">expand_more</span>
        </div>
        <div class="table-wrapper collapse-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Kalem</th>
                        <th class="text-right">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.StationUnitCostTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--primary);">electric_car</span>Araç Şarj İstasyonu</span></td>
                            <td class="text-right"><span class="js-money" data-tl="@RAW(Model.StationUnitCostTl)" data-dec="0">@N0(Model.StationUnitCostTl) ₺</span></td>
                        </tr>
                    }
                    @if (Model.ProviderEntryFeeTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--text-muted);">handshake</span>Yer Sağlayıcı Giriş Bedeli</span></td>
                            <td class="text-right"><span class="js-money" data-tl="@RAW(Model.ProviderEntryFeeTl)" data-dec="0">@N0(Model.ProviderEntryFeeTl) ₺</span></td>
                        </tr>
                    }
                    @if (Model.InfrastructureCostTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--text-muted);">construction</span>Altyapı Yatırımı</span></td>
                            <td class="text-right"><span class="js-money" data-tl="@RAW(Model.InfrastructureCostTl)" data-dec="0">@N0(Model.InfrastructureCostTl) ₺</span></td>
                        </tr>
                    }
                    @if (Model.DeviceTotalTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--text-muted);">developer_board</span>Cihaz + Lokasyon</span></td>
                            <td class="text-right"><span class="js-money" data-tl="@RAW(Model.DeviceTotalTl)" data-dec="0">@N0(Model.DeviceTotalTl) ₺</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="tfoot-row">
                        <td><strong>Toplam Yatırım</strong></td>
                        <td class="text-right"><strong><span class="js-money" data-tl="@RAW(Model.TotalInvestmentTl)" data-dec="0">@N0(Model.TotalInvestmentTl) ₺</span></strong></td>
                    </tr>
                    @if (Model.ContractMonths > 0)
                    {
                        <tr class="tfoot-row">
                            <td>Sözleşme Süresi</td>
                            <td class="text-right"><strong>@Model.ContractMonths ay</strong></td>
                        </tr>
                    }
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Geri Kazanım Özeti -->
    <div class="card res-section">
        <div class="res-sec-header" onclick="toggleSec(this)">
            <div class="res-sec-icon" style="background:var(--success-50);">
                <span class="material-symbols-outlined" style="color:var(--success);">savings</span>
            </div>
            <div>
                <div class="res-sec-title">Geri Kazanım Özeti</div>
                <div class="res-sec-sub">Yıllık gelir/gider ve amorti süresi</div>
            </div>
            <span class="material-symbols-outlined res-sec-chevron">expand_more</span>
        </div>
        <div class="table-wrapper collapse-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Kalem</th>
                        <th class="text-right">Tutar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecoverableInvestmentUsd > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--primary);">move_up</span>Taşınabilir Yatırım (Şarj İstasyonu)</span></td>
                            <td class="text-right"><span class="js-money" data-usd="@RAW(Model.RecoverableInvestmentUsd)" data-dec="0">@USD(Model.RecoverableInvestmentUsd)</span></td>
                        </tr>
                    }
                    <tr>
                        <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--danger);">anchor</span>Geri Kazanılacak (Gömülü) Yatırım</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-usd="@RAW(Model.SunkInvestmentUsd)" data-dec="0">@USD(Model.SunkInvestmentUsd)</span></td>
                    </tr>
                    @if (Model.HasRent)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--danger);">home_work</span>Yıllık Kira</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-Model.AnnualRentTl)" data-dec="0">-@N0(Model.AnnualRentTl) ₺</span></td>
                        </tr>
                    }
                    @if (Model.AnnualMaintenanceTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--danger);">build</span>Yıllık Bakım</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-Model.AnnualMaintenanceTl)" data-dec="0">-@N0(Model.AnnualMaintenanceTl) ₺</span></td>
                        </tr>
                    }
                    @if (Model.AnnualAdvertisingRevenueTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--success);">campaign</span>Yıllık Reklam Geliri</span></td>
                            <td class="text-right c-pos"><span class="js-money" data-tl="@RAW(Model.AnnualAdvertisingRevenueTl)" data-dec="0">+@N0(Model.AnnualAdvertisingRevenueTl) ₺</span></td>
                        </tr>
                    }
                    @if (Model.HasLoan && Model.AnnualLoanPaymentTl > 0)
                    {
                        <tr>
                            <td><span class="tbl-icon"><span class="material-symbols-outlined" style="color:var(--danger);">credit_card</span>Yıllık Kredi Ödemesi (@Model.LoanTermMonths ay)</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-Model.AnnualLoanPaymentTl)" data-dec="0">-@N0(Model.AnnualLoanPaymentTl) ₺</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="tfoot-row">
                        <td><strong>Amorti Süresi</strong></td>
                        <td class="text-right">
                            @if (displayPayback > 0)
                            {
                                <strong class="@(paybackWithinContract ? "c-pos" : "")">@displayPayback.ToString("0.0", tr) Yıl</strong>
                                if (!paybackWithinContract)
                                {
                                    <span style="font-size:.72rem;color:var(--warning);margin-left:6px;font-weight:600;">sözleşme dışı</span>
                                }
                            }
                            else
                            {
                                <span style="color:var(--text-muted);">Hesaplanamadı</span>
                            }
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>

<!-- ═══ YILLIK NAKİT AKIŞI ════════════════════════════════════════════ -->
@if (Model.YearSummaries.Any())
{
    <div class="card res-section" style="margin-bottom:16px;">
        <div class="res-sec-header" onclick="toggleSec(this)">
            <div class="res-sec-icon" style="background:var(--primary-50);">
                <span class="material-symbols-outlined" style="color:var(--primary);">bar_chart</span>
            </div>
            <div>
                <div class="res-sec-title">Yıllık Nakit Akışı Projeksiyonu</div>
                <div class="res-sec-sub">Sözleşme süresi boyunca gelir, gider ve kümülatif bakiye</div>
            </div>
            <div class="res-cur-wrap" onclick="event.stopPropagation();">
                <label>Para Birimi</label>
                <select class="res-cur-select" onchange="fizSelectCurrency(this)">
                    <option value="TRY">₺ TRY</option>
                    <option value="USD">$ USD</option>
                    <option value="EUR">€ EUR</option>
                </select>
            </div>
            <span class="material-symbols-outlined res-sec-chevron">expand_more</span>
        </div>
        <div class="table-wrapper collapse-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Yıl</th>
                        <th class="text-right">Brüt Ciro</th>
                        <th class="text-right">Elektrik</th>
                        <th class="text-right">Komisyon</th>
                        <th class="text-right">Sabit Gider</th>
                        <th class="text-right">Net Kâr</th>
                        <th class="text-right">Kümülatif (USD)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.YearSummaries)
                    {
                        <tr>
                            <td><strong>@r.Year</strong></td>
                            <td class="text-right c-pos"><span class="js-money" data-tl="@RAW(r.TotalRevenueTl)" data-dec="0">@N0(r.TotalRevenueTl) ₺</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-r.TotalElectricityCostTl)" data-dec="0">-@N0(r.TotalElectricityCostTl) ₺</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-r.TotalCommissionTl)" data-dec="0">-@N0(r.TotalCommissionTl) ₺</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-r.FixedCostsTl)" data-dec="0">-@N0(r.FixedCostsTl) ₺</span></td>
                            <td class="text-right @(pos(r.NetProfitTl) ? "c-pos" : "c-neg")"><span class="js-money" data-tl="@RAW(r.NetProfitTl)" data-dec="0">@sign(r.NetProfitTl)@N0(r.NetProfitTl) ₺</span></td>
                            <td class="text-right @(pos(r.CumulativeBalanceUsd) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(r.CumulativeBalanceUsd)" data-dec="0">@sign(r.CumulativeBalanceUsd)@USD(r.CumulativeBalanceUsd)</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @{
                        var tRev  = Model.YearSummaries.Sum(r => r.TotalRevenueTl);
                        var tElec = Model.YearSummaries.Sum(r => r.TotalElectricityCostTl);
                        var tComm = Model.YearSummaries.Sum(r => r.TotalCommissionTl);
                        var tFix  = Model.YearSummaries.Sum(r => r.FixedCostsTl);
                        var tNet  = Model.YearSummaries.Sum(r => r.NetProfitTl);
                        var tCumU = Model.YearSummaries.Last().CumulativeBalanceUsd;
                    }
                    <tr class="tfoot-row">
                        <td>Toplam</td>
                        <td class="text-right c-pos"><span class="js-money" data-tl="@RAW(tRev)" data-dec="0">@N0(tRev) ₺</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-tElec)" data-dec="0">-@N0(tElec) ₺</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-tComm)" data-dec="0">-@N0(tComm) ₺</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-tFix)" data-dec="0">-@N0(tFix) ₺</span></td>
                        <td class="text-right @(pos(tNet) ? "c-pos" : "c-neg")"><span class="js-money" data-tl="@RAW(tNet)" data-dec="0">@sign(tNet)@N0(tNet) ₺</span></td>
                        <td class="text-right @(pos(tCumU) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(tCumU)" data-dec="0">@sign(tCumU)@USD(tCumU)</span></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- ═══ AMORTİ TABLOSU ════════════════════════════════════════════════ -->
@if (Model.SunkAmortization.Any())
{
    <div class="card res-section" style="margin-bottom:16px;">
        <div class="res-sec-header" onclick="toggleSec(this)">
            <div class="res-sec-icon" style="background:var(--success-50);">
                <span class="material-symbols-outlined" style="color:var(--success);">assignment_turned_in</span>
            </div>
            <div>
                <div class="res-sec-title">Yatırım Geri Kazanım (Amorti) Tablosu</div>
                <div class="res-sec-sub">Gömülü yatırımın yıl bazında geri kazanım ilerlemesi</div>
            </div>
            <span class="material-symbols-outlined res-sec-chevron">expand_more</span>
        </div>
        <div class="table-wrapper collapse-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Yıl</th>
                        <th class="text-right">Yıllık Net Kâr (USD)</th>
                        <th class="text-right">Kümülatif Geri Kazanım</th>
                        <th class="text-right">Kalan Maliyet</th>
                        <th class="text-center">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.SunkAmortization)
                    {
                        <tr class="@(r.IsPaybackYear ? "tfoot-row" : "")">
                            <td><strong>@r.Year</strong></td>
                            <td class="text-right @(pos(r.NetProfitUsd) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(r.NetProfitUsd)" data-dec="0">@sign(r.NetProfitUsd)@USD(r.NetProfitUsd)</span></td>
                            <td class="text-right c-neu"><span class="js-money" data-usd="@RAW(r.RecoveredCumulativeUsd)" data-dec="0">@USD(r.RecoveredCumulativeUsd)</span></td>
                            <td class="text-right @(r.RemainingUsd > 0 ? "c-neg" : "c-pos")"><span class="js-money" data-usd="@RAW(r.RemainingUsd)" data-dec="0">@USD(r.RemainingUsd)</span></td>
                            <td class="text-center">
                                @if (r.IsPaybackYear)
                                {
                                    <span style="display:inline-flex;align-items:center;gap:4px;background:var(--success-50);color:var(--success);font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:20px;">
                                        <span class="material-symbols-outlined" style="font-size:14px;font-variation-settings:'FILL' 1,'wght' 400,'GRAD' 0,'opsz' 24;">check_circle</span>
                                        Amorti Edildi
                                    </span>
                                }
                                else if (r.RemainingUsd <= 0)
                                {
                                    <span class="c-pos" style="font-size:.8rem;font-weight:600;">✓ Geçti</span>
                                }
                                else
                                {
                                    <span class="c-neu" style="font-size:.8rem;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
    function toggleSec(header) {
        header.closest('.card').classList.toggle('collapsed');
    }

    setTimeout(function () {
        var b = document.getElementById('successBanner');
        if (b) b.classList.add('hide');
    }, 2000);

    (function () {
        var FXR = { TRY: 1, USD: 0, EUR: 0 };
        var SYM = { TRY: '₺', USD: '$', EUR: '€' };
        var CUR = 'TRY';

        function fmt(n, dec) {
            return new Intl.NumberFormat('tr-TR', { minimumFractionDigits: dec, maximumFractionDigits: dec }).format(n);
        }

        function renderMoney() {
            var rate = FXR[CUR] || 0;
            var sym  = SYM[CUR];
            if (CUR !== 'TRY' && rate <= 0) return;
            document.querySelectorAll('.js-money').forEach(function (el) {
                var tl;
                var aTl = el.getAttribute('data-tl');
                if (aTl !== null) {
                    tl = parseFloat(aTl);
                } else {
                    var usd = parseFloat(el.getAttribute('data-usd'));
                    if (isNaN(usd) || (FXR.USD || 0) <= 0) return;
                    tl = usd * FXR.USD;
                }
                if (isNaN(tl)) return;
                var dec = parseInt(el.getAttribute('data-dec') || '0', 10);
                var val = CUR === 'TRY' ? tl : (rate > 0 ? tl / rate : 0);
                var neg = val < 0;
                var abs = Math.abs(val);
                var body = (CUR === 'TRY') ? (fmt(abs, dec) + ' ' + sym) : (sym + ' ' + fmt(abs, dec));
                el.textContent = (neg ? '-' : '') + body;
            });
        }

        window.fizSelectCurrency = function (sel) {
            CUR = sel.value;
            document.querySelectorAll('.res-cur-select').forEach(function (s) { s.value = CUR; });
            renderMoney();
        };

        fetch('/FeasibilityAmortization/GetRates')
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (d && d.usdSell > 0) FXR.USD = d.usdSell;
                if (d && d.eurSell > 0) FXR.EUR = d.eurSell;
                renderMoney();
            })
            .catch(function () {});
    })();
</script>
}
