                    <tr>
                        <td>Ocak</td>
                        <td>13.25</td>
                        <td>$3,212.37</td>
                        <td class="text-danger-fz">-$481.86</td>
                        <td class="text-danger-fz">-$74.92</td>
                        <td class="text-danger-fz">-$2,044.24</td>
                        <td class="text-success-fz">+$611.36</td>
                        <td class="text-danger-fz">-$120,690.98</td>
                    </tr>
                    <tr>
                        <td>Şubat</td>
                        <td>11.97</td>
                        <td>$2,901.50</td>
                        <td class="text-danger-fz">-$435.22</td>
                        <td class="text-danger-fz">-$74.92</td>
                        <td class="text-danger-fz">-$1,846.41</td>
                        <td class="text-success-fz">+$544.94</td>
                        <td class="text-danger-fz">-$120,146.04</td>
                    </tr>
                    <tr>
                        <td>Mart</td>
                        <td>13.25</td>
                        <td>$3,212.37</td>
                        <td class="text-danger-fz">-$481.86</td>
                        <td class="text-danger-fz">-$74.92</td>
                        <td class="text-danger-fz">-$2,044.24</td>
                        <td class="text-success-fz">+$611.36</td>
                        <td class="text-danger-fz">-$119,534.68</td>
                    </tr>
                    <tr>
                        <td>Nisan</td>
                        <td>12.82</td>
                        <td>$3,108.75</td>
                        <td class="text-danger-fz">-$466.31</td>
                        <td class="text-danger-fz">-$74.92</td>
