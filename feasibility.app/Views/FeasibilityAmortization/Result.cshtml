@using System.Globalization
@model feasibility.Entity.Dtos.FeasibilityAmortization.FeasibilityAmortizationDetailDto
@{
    ViewData["Title"] = Model.FeasibilityName + " — Sonuç";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
    var tr  = CultureInfo.GetCultureInfo("tr-TR");
    Func<decimal, string> N0  = v => v.ToString("#,##0", tr);
    Func<decimal, string> N2  = v => v.ToString("#,##0.##", tr);
    Func<decimal, string> USD = v => "$ " + v.ToString("#,##0", tr);
    Func<decimal, string> PCT = v => "%" + v.ToString("0.0", tr);
    bool pos(decimal v) => v >= 0;
    string sign(decimal v) => v >= 0 ? "+" : "";
}

@section Styles {
    <style>
        /* KPI kartları */
        .kpi-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin-bottom: 24px; }
        @@media(max-width:900px){ .kpi-row{grid-template-columns:repeat(2,1fr);} }
        @@media(max-width:500px){ .kpi-row{grid-template-columns:1fr;} }

        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .kpi-ico {
            width: 44px; height: 44px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
        }
        .kpi-ico .material-symbols-outlined { font-size: 1.3rem; }
        .kpi-lbl { font-size: .7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: .5px; margin-bottom: 3px; }
        .kpi-v   { font-size: 1.3rem; font-weight: 800; color: var(--text); margin: 0; }
        .kpi-v.pos { color: var(--success); }
        .kpi-v.neg { color: var(--danger); }

        /* Bölüm kartları */
        .res-section { margin-bottom: 20px; }

        .res-card-header {
            display: flex; align-items: center; gap: 10px;
        }
        .res-card-header .fiz-ix { background: var(--primary); }
        .res-card-header .material-symbols-outlined { font-size: 18px; color: var(--primary); }

        /* İki sütunlu özet */
        .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px; }
        @@media(max-width:700px){ .summary-grid{grid-template-columns:1fr;} }

        /* Info satırları (card içinde) */
        .res-row {
            display: flex; justify-content: space-between; align-items: center;
            padding: .45rem 0; border-bottom: 1px solid var(--border);
            font-size: .875rem;
        }
        .res-row:last-child { border-bottom: none; }
        .res-row .rl { color: var(--text-muted); font-weight: 500; }
        .res-row .rv { font-weight: 700; color: var(--text); font-family: 'Courier New', monospace; font-size: .875rem; }
        .res-row .rv.pos { color: var(--success); }
        .res-row .rv.neg { color: var(--danger); }
        .res-row.total { background: var(--surface-2); border-radius: 8px; padding: .55rem .65rem; margin-top: 4px; }
        .res-row.total .rl { font-weight: 700; color: var(--text); }
        .res-row.total .rv { font-size: 1rem; }

        /* Tablo renk yardımcıları */
        .c-pos { color: var(--success) !important; font-weight: 700; }
        .c-neg { color: var(--danger)  !important; font-weight: 700; }
        .c-neu { color: var(--text-muted); }

        .tfoot-row td { background: var(--surface-2) !important; font-weight: 800; border-top: 2px solid var(--border); }

        /* Hat badge */
        .hat-badge {
            background: var(--primary-50); color: var(--primary);
            font-size: .75rem; font-weight: 800;
            padding: .2rem .65rem; border-radius: 999px;
        }

        /* Pasif banner */
        .passive-banner {
            background: var(--danger-50); border: 1px solid rgba(217,38,38,.25);
            color: var(--danger); border-radius: var(--radius);
            padding: .75rem 1rem; margin-bottom: 16px;
            display: flex; align-items: center; gap: .5rem;
            font-size: .875rem; font-weight: 600;
        }
    </style>
}

<!-- Sayfa başlığı -->
<div class="page-header">
    <div>
        <div class="crumb">Fizibiliteler &middot; Amortisman &middot; <strong>@Model.FeasibilityName</strong></div>
        <h1>Fizibilite Sonuç Raporu</h1>
        <p>@Model.LocationName &nbsp;&middot;&nbsp; @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</p>
    </div>
    <div class="header-actions">
        <a href="/FeasibilityAmortization/Index" class="btn btn-secondary">
            <span class="material-symbols-outlined">arrow_back</span> Geri
        </a>
        <a href="/FeasibilityAmortization/Details/@Model.Id" class="btn btn-secondary">
            <span class="material-symbols-outlined">info</span> Detaylar
        </a>
        @if (!Model.IsDeleted)
        {
            <a href="/FeasibilityAmortization/Edit/@Model.Id" class="btn btn-primary">
                <span class="material-symbols-outlined">edit</span> Düzenle
            </a>
        }
    </div>
</div>

@if (Model.IsDeleted)
{
    <div class="passive-banner">
        <span class="material-symbols-outlined">warning</span>
        Bu fizibilite pasif durumda.
    </div>
}

<!-- KPI Kartları -->
<div class="kpi-row">
    <div class="kpi-card">
        <div class="kpi-ico" style="background:var(--primary-50);color:var(--primary);">
            <span class="material-symbols-outlined">account_balance_wallet</span>
        </div>
        <div>
            <div class="kpi-lbl">Toplam Yatırım</div>
            <div class="kpi-v">@USD(Model.TotalInvestmentUsd)</div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-ico" style="background:var(--success-50);color:var(--success);">
            <span class="material-symbols-outlined">restart_alt</span>
        </div>
        <div>
            <div class="kpi-lbl">Amortisman Süresi</div>
            <div class="kpi-v @(Model.PaybackYears > 0 ? "" : "neg")">
                @(Model.PaybackYears > 0 ? Model.PaybackYears.ToString("0.0", tr) + " Yıl" : "—")
            </div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-ico" style="background:var(--warning-50);color:var(--warning);">
            <span class="material-symbols-outlined">trending_up</span>
        </div>
        <div>
            <div class="kpi-lbl">Yıl 1 Net Kâr</div>
            <div class="kpi-v @(pos(Model.AnnualNetProfitUsd) ? "pos" : "neg")">
                @sign(Model.AnnualNetProfitUsd)@USD(Model.AnnualNetProfitUsd)
            </div>
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-ico" style="background:var(--primary-50);color:var(--primary);">
            <span class="material-symbols-outlined">percent</span>
        </div>
        <div>
            <div class="kpi-lbl">Yıllık ROI</div>
            <div class="kpi-v @(pos(Model.RoiPercent) ? "pos" : "neg")">
                @sign(Model.RoiPercent)@PCT(Model.RoiPercent)
            </div>
        </div>
    </div>
</div>

<!-- Yatırım + Sabit Giderler özeti -->
<div class="summary-grid">
    <div class="card res-section">
        <div class="card-header">
            <div class="res-card-header">
                <div class="fiz-ix">01</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yatırım Dağılımı</h2>
                    <div class="fiz-sub">Toplam sermaye harcaması</div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="res-row"><span class="rl">Araç Şarj İstasyonu</span><span class="rv">@N0(Model.StationUnitCostTl) ₺</span></div>
            <div class="res-row"><span class="rl">Yer Sağlayıcı Giriş Bedeli</span><span class="rv">@N0(Model.ProviderEntryFeeTl) ₺</span></div>
            <div class="res-row"><span class="rl">Altyapı Yatırımı</span><span class="rv">@N0(Model.InfrastructureCostTl) ₺</span></div>
            <div class="res-row"><span class="rl">Cihaz + Lokasyon</span><span class="rv">@N0(Model.DeviceTotalTl) ₺</span></div>
            <div class="res-row total"><span class="rl">Toplam Yatırım (TL)</span><span class="rv">@N0(Model.TotalInvestmentTl) ₺</span></div>
            <div class="res-row total"><span class="rl">Toplam Yatırım (USD)</span><span class="rv">@USD(Model.TotalInvestmentUsd)</span></div>
            @if (Model.ContractMonths > 0)
            {
                <div class="res-row"><span class="rl">Sözleşme Süresi</span><span class="rv">@Model.ContractMonths ay</span></div>
            }
        </div>
    </div>

    <div class="card res-section">
        <div class="card-header">
            <div class="res-card-header">
                <div class="fiz-ix">02</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yıllık Sabit Giderler &amp; Parametreler</h2>
                    <div class="fiz-sub">Kur, enflasyon ve gider kalemleri</div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="res-row"><span class="rl">USD/TL Kuru</span><span class="rv">@N2(Model.UsdRate)</span></div>
            <div class="res-row"><span class="rl">EUR/TL Kuru</span><span class="rv">@N2(Model.EurRate)</span></div>
            <div class="res-row"><span class="rl">TL Enflasyonu</span><span class="rv">%@N2(Model.InflationTl)</span></div>
            <div class="res-row"><span class="rl">USD Enflasyonu</span><span class="rv">%@N2(Model.InflationUsd)</span></div>
            @if (Model.HasRent)
            {
                <div class="res-row"><span class="rl">Yıllık Kira</span><span class="rv neg">-@N0(Model.AnnualRentTl) ₺</span></div>
            }
            @if (Model.AnnualMaintenanceTl > 0)
            {
                <div class="res-row"><span class="rl">Yıllık Bakım</span><span class="rv neg">-@N0(Model.AnnualMaintenanceTl) ₺</span></div>
            }
            @if (Model.AnnualAdvertisingRevenueTl > 0)
            {
                <div class="res-row"><span class="rl">Yıllık Reklam Geliri</span><span class="rv pos">+@N0(Model.AnnualAdvertisingRevenueTl) ₺</span></div>
            }
            @if (Model.HasLoan && Model.AnnualLoanPaymentTl > 0)
            {
                <div class="res-row"><span class="rl">Yıllık Kredi Ödemesi (@Model.LoanTermMonths ay)</span><span class="rv neg">-@N0(Model.AnnualLoanPaymentTl) ₺</span></div>
            }
            <div class="res-row total"><span class="rl">Yıl 1 Net Kâr (TL)</span>
                <span class="rv @(pos(Model.AnnualNetProfitTl) ? "pos" : "neg")">@sign(Model.AnnualNetProfitTl)@N0(Model.AnnualNetProfitTl) ₺</span>
            </div>
        </div>
    </div>
</div>

<!-- 10 Yıllık Projeksiyon Tablosu -->
@if (Model.YearSummaries.Any())
{
    <div class="card res-section">
        <div class="card-header">
            <div class="res-card-header">
                <div class="fiz-ix">03</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yıllık Nakit Akışı Projeksiyonu</h2>
                    <div class="fiz-sub">H1 = Ocak–Mayıs (151 gün) · H2 = Haziran–Aralık (214 gün)</div>
                </div>
            </div>
        </div>
        <div class="table-wrapper">
            <table class="table">
                <thead>
                    <tr>
                        <th>Yıl</th>
                        <th class="text-right">Brüt Ciro (TL)</th>
                        <th class="text-right">Elektrik (TL)</th>
                        <th class="text-right">Komisyon (TL)</th>
                        <th class="text-right">Sabit Gider (TL)</th>
                        <th class="text-right">Net Kâr (TL)</th>
                        <th class="text-right">USD/TL</th>
                        <th class="text-right">Net Kâr (USD)</th>
                        <th class="text-right">Kümülatif (USD)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.YearSummaries)
                    {
                        <tr>
                            <td><strong>@r.Year</strong></td>
                            <td class="text-right c-pos">@N0(r.TotalRevenueTl) ₺</td>
                            <td class="text-right c-neg">-@N0(r.TotalElectricityCostTl) ₺</td>
                            <td class="text-right c-neg">-@N0(r.TotalCommissionTl) ₺</td>
                            <td class="text-right c-neg">-@N0(r.FixedCostsTl) ₺</td>
                            <td class="text-right @(pos(r.NetProfitTl) ? "c-pos" : "c-neg")">@sign(r.NetProfitTl)@N0(r.NetProfitTl) ₺</td>
                            <td class="text-right c-neu">@N2(r.UsdRate)</td>
                            <td class="text-right @(pos(r.NetProfitUsd) ? "c-pos" : "c-neg")">@sign(r.NetProfitUsd)@USD(r.NetProfitUsd)</td>
                            <td class="text-right @(pos(r.CumulativeBalanceUsd) ? "c-pos" : "c-neg")">@sign(r.CumulativeBalanceUsd)@USD(r.CumulativeBalanceUsd)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @{
                        var tRev  = Model.YearSummaries.Sum(r => r.TotalRevenueTl);
                        var tElec = Model.YearSummaries.Sum(r => r.TotalElectricityCostTl);
                        var tComm = Model.YearSummaries.Sum(r => r.TotalCommissionTl);
                        var tFix  = Model.YearSummaries.Sum(r => r.FixedCostsTl);
                        var tNet  = Model.YearSummaries.Sum(r => r.NetProfitTl);
                        var tNetU = Model.YearSummaries.Sum(r => r.NetProfitUsd);
                        var tCum  = Model.YearSummaries.Last().CumulativeBalanceUsd;
                    }
                    <tr class="tfoot-row">
                        <td>Toplam</td>
                        <td class="text-right c-pos">@N0(tRev) ₺</td>
                        <td class="text-right c-neg">-@N0(tElec) ₺</td>
                        <td class="text-right c-neg">-@N0(tComm) ₺</td>
                        <td class="text-right c-neg">-@N0(tFix) ₺</td>
                        <td class="text-right @(pos(tNet) ? "c-pos" : "c-neg")">@sign(tNet)@N0(tNet) ₺</td>
                        <td class="text-right">—</td>
                        <td class="text-right @(pos(tNetU) ? "c-pos" : "c-neg")">@sign(tNetU)@USD(tNetU)</td>
                        <td class="text-right @(pos(tCum) ? "c-pos" : "c-neg")">@sign(tCum)@USD(tCum)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

<!-- İstasyon Hattı Detayları -->
@{ int lineNo = 4; }
@foreach (var line in Model.DeviceLines)
{
    <div class="card res-section">
        <div class="card-header">
            <div class="res-card-header">
                <div class="fiz-ix">@lineNo.ToString("00")</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;display:flex;align-items:center;gap:8px;">
                        <span class="hat-badge">@line.DeviceType</span>
                        İstasyon Hattı — @line.DeviceCount Cihaz · @line.SocketCount Soket · @line.AgreementGenre (@((line.AgreementRate * 100).ToString("0.#", tr))%)
                    </h2>
                    <div class="fiz-sub">Hat yatırımı: @N0(line.LineInvestmentTl) ₺ · Yıl 1 net marj: <span class="@(pos(line.AnnualNetMarginTl) ? "c-pos" : "c-neg")">@sign(line.AnnualNetMarginTl)@N0(line.AnnualNetMarginTl) ₺</span></div>
                </div>
            </div>
        </div>
        @if (line.YearProjections.Any())
        {
            <div class="table-wrapper">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Yıl</th>
                            <th class="text-right">Şarj/Soket</th>
                            <th class="text-right">Satış Ocak (₺/kWh)</th>
                            <th class="text-right">Satış Haziran (₺/kWh)</th>
                            <th class="text-right">Alış Ocak (₺/kWh)</th>
                            <th class="text-right">Alış Haziran (₺/kWh)</th>
                            <th class="text-right">Yıllık Ciro (TL)</th>
                            <th class="text-right">Elektrik (TL)</th>
                            <th class="text-right">Komisyon (TL)</th>
                            <th class="text-right">Brüt Marj (TL)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in line.YearProjections)
                        {
                            var margin = p.AnnualRevenueTl - p.AnnualElectricityCostTl - p.AnnualCommissionTl;
                            <tr>
                                <td><strong>@p.Year</strong></td>
                                <td class="text-right">@N2(p.DailyChargePerSocket)</td>
                                <td class="text-right">@N2(p.SalePriceH1) ₺</td>
                                <td class="text-right">@N2(p.SalePriceH2) ₺</td>
                                <td class="text-right">@N2(p.PurchasePriceH1) ₺</td>
                                <td class="text-right">@N2(p.PurchasePriceH2) ₺</td>
                                <td class="text-right c-pos">@N0(p.AnnualRevenueTl) ₺</td>
                                <td class="text-right c-neg">-@N0(p.AnnualElectricityCostTl) ₺</td>
                                <td class="text-right c-neg">-@N0(p.AnnualCommissionTl) ₺</td>
                                <td class="text-right @(pos(margin) ? "c-pos" : "c-neg")">@sign(margin)@N0(margin) ₺</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    lineNo++;
}
