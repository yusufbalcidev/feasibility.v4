@{
    ViewData["Title"] = "Yatırım Geri Dönüş Raporu";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --slate-900: #111827;
            --slate-700: #334155;
            --slate-500: #64748b;
            --line: #e6eaf2;
            --surface: #ffffff;
            --canvas: #f4f6fb;
            --accent: #2563eb;
            --success: #059669;
            --warning: #d97706;
            --danger: #dc2626;
            --radius: 14px;
            --radius-sm: 10px;
            --shadow-sm: 0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.05);
            --shadow-md: 0 12px 30px rgba(16,24,40,.07);
        }

        .fz-scope {
            font-family: "Plus Jakarta Sans", -apple-system, "Segoe UI", sans-serif;
            color: var(--slate-900);
        }

        /* ---------- Header ---------- */
        .fz-header {
            background: linear-gradient(120deg, #0b1f33 0%, #14304a 60%, #1c3d5a 100%);
            border-radius: var(--radius);
            color: #fff;
            padding: 1.75rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.25rem;
            flex-wrap: wrap;
            box-shadow: var(--shadow-md);
        }

            .fz-header h2 {
                font-weight: 800;
                font-size: 1.45rem;
                letter-spacing: -.4px;
                margin: 0 0 .35rem;
            }

            .fz-header p {
                margin: 0;
                color: rgba(255,255,255,.8);
                font-size: .95rem;
                font-weight: 500;
            }

        /* ---------- Buttons ---------- */
        .btn-fz {
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: .9rem;
            padding: .65rem 1.4rem;
            border: 1px solid transparent;
            transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
            display: inline-flex;
            align-items: center;
            gap: .55rem;
        }

        .btn-fz-primary {
            background: var(--accent);
            color: #fff;
            box-shadow: 0 6px 16px rgba(37,99,235,.28);
        }

            .btn-fz-primary:hover {
                background: #1d4ed8;
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-fz-ghost {
            background: rgba(255,255,255,0.1);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.2);
        }

            .btn-fz-ghost:hover {
                background: rgba(255,255,255,0.2);
                color: #fff;
            }

        /* ---------- Cards & KPIs ---------- */
        .fz-card {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1.25rem;
            height: 100%;
        }

        .kpi-icon {
            width: 50px;
            height: 50px;
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .kpi-title {
            font-size: 0.75rem;
            color: var(--slate-500);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 0.25rem;
        }

        .kpi-value {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--slate-900);
            margin: 0;
        }

        /* ---------- Tables ---------- */
        .table-wrapper {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
        }

        .table-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--line);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: .5rem;
        }

            .table-header h5 {
                margin: 0;
                font-weight: 700;
                font-size: 1.1rem;
            }

        .table-scroll {
            overflow-x: auto;
        }

        .fz-table {
            width: 100%;
            border-collapse: collapse;
        }

            .fz-table th {
                background: var(--canvas);
                color: var(--slate-500);
                font-weight: 600;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                padding: 1rem 1.25rem;
                text-align: right;
                border-bottom: 1px solid var(--line);
                white-space: nowrap;
            }

                .fz-table th:first-child {
                    text-align: left;
                }

            .fz-table td {
                padding: 1rem 1.25rem;
                text-align: right;
                border-bottom: 1px solid var(--line);
                font-weight: 600;
                color: var(--slate-900);
                font-size: 0.9rem;
                white-space: nowrap;
            }

                .fz-table td:first-child {
                    text-align: left;
                    color: var(--slate-700);
                }

            .fz-table tr:last-child td {
                border-bottom: none;
            }

        .text-success-fz {
            color: var(--success) !important;
        }

        .text-danger-fz {
            color: var(--danger) !important;
        }

        @@media (max-width: 768px) {
            .fz-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }
    </style>
}

<div class="container-fluid mt-4 mb-5 fz-scope">

    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="fz-card">
                <div class="kpi-icon" style="background: #eef4ff; color: #2563eb;">
                    <i class="fas fa-wallet"></i>
                </div>
                <div>
                    <div class="kpi-title">Cihaz Başına Yatırım</div>
                    <div class="kpi-value">$121,302</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="fz-card">
                <div class="kpi-icon" style="background: #e8f7f0; color: #059669;">
                    <i class="fas fa-undo"></i>
                </div>
                <div>
                    <div class="kpi-title">Amortisman Süresi</div>
                    <div class="kpi-value">16.9 Yıl</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="fz-card">
                <div class="kpi-icon" style="background: #fdf3e3; color: #d97706;">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div>
                    <div class="kpi-title">Yıllık Net Kâr (Brüt)</div>
                    <div class="kpi-value text-success-fz">+$7,181</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="fz-card">
                <div class="kpi-icon" style="background: #e5f6fb; color: #0891b2;">
                    <i class="fas fa-percent"></i>
                </div>
                <div>
                    <div class="kpi-title">Yıllık Getiri (ROI)</div>
                    <div class="kpi-value">%5.9</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="table-wrapper">
        <div class="table-header">
