                        <td class="text-danger-fz">-$118,945.46</td>
                    </tr>
                    <tr style="background: #fdfdfd;">
                        <td class="fw-bold text-dark">Yıl Sonu Toplam</td>
                        <td class="fw-bold">156.04</td>
                        <td class="fw-bold">$37,823.10</td>
                        <td class="fw-bold text-danger-fz">-$5,673.47</td>
                        <td class="fw-bold text-danger-fz">-$899.07</td>
                        <td class="fw-bold text-danger-fz">-$24,069.25</td>
