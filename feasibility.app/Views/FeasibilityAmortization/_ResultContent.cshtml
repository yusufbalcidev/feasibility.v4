@using System.Globalization
@model feasibility.Entity.Dtos.FeasibilityAmortization.FeasibilityAmortizationDetailDto
@{
    var tr  = CultureInfo.GetCultureInfo("tr-TR");
    var inv = CultureInfo.InvariantCulture;
    Func<decimal, string> N0  = v => v.ToString("#,##0", tr);
    Func<decimal, string> N2  = v => v.ToString("#,##0.##", tr);
    Func<decimal, string> USD = v => "$ " + v.ToString("#,##0", tr);
    Func<decimal, string> PCT = v => "%" + v.ToString("0.0", tr);
    bool pos(decimal v) => v >= 0;
    string sign(decimal v) => v >= 0 ? "+" : "";

    Func<decimal, string> RAW = v => v.ToString("0.########", inv);
}

<div class="res-cur-bar">
    <button type="button" class="btn btn-primary res-pdf-btn" onclick="resDownloadPdf()">
        <span class="material-symbols-outlined">picture_as_pdf</span> PDF olarak indir
    </button>
    <div class="fiz-cur-wrap" style="margin-left:auto;">
        <label>Para Birimi</label>
        <select class="fiz-cur-select" onchange="fizSelectCurrency(this)">
            <option value="USD" selected>$ USD</option>
            <option value="TRY">₺ TRY</option>
            <option value="EUR">€ EUR</option>
        </select>
    </div>
</div>

<div class="res-kpi-row">
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon"><span class="material-symbols-outlined">account_balance_wallet</span></div>
            <span class="res-kpi-badge">Yatırım</span>
        </div>
        <div>
            <div class="res-kpi-value"><span class="js-money" data-tl="@RAW(Model.TotalInvestmentTl)" data-dec="0">@N0(Model.TotalInvestmentTl) ₺</span></div>
            <div class="res-kpi-label">Toplam Yatırım</div>
        </div>
    </div>
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon"><span class="material-symbols-outlined">restart_alt</span></div>
            <span class="res-kpi-badge">Amortisman</span>
        </div>
        <div>
            <div class="res-kpi-value @(Model.PaybackYears > 0 ? "" : "neg")">
                @(Model.PaybackYears > 0 ? Model.PaybackYears.ToString("0.0", tr) + " Yıl" : "—")
            </div>
            <div class="res-kpi-label">Amortisman Süresi</div>
        </div>
    </div>
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon"><span class="material-symbols-outlined">trending_up</span></div>
            <span class="res-kpi-badge">Yıl 1</span>
        </div>
        <div>
            <div class="res-kpi-value @(pos(Model.AnnualNetProfitTl) ? "pos" : "neg")">
                <span class="js-money" data-tl="@RAW(Model.AnnualNetProfitTl)" data-dec="0">@sign(Model.AnnualNetProfitTl)@N0(Model.AnnualNetProfitTl) ₺</span>
            </div>
            <div class="res-kpi-label">Yıl 1 Net Kâr</div>
        </div>
    </div>
    <div class="res-kpi">
        <div class="res-kpi-header">
            <div class="res-kpi-icon"><span class="material-symbols-outlined">percent</span></div>
            <span class="res-kpi-badge">ROI</span>
        </div>
        <div>
            <div class="res-kpi-value @(pos(Model.RoiPercent) ? "pos" : "neg")">
                @sign(Model.RoiPercent)@PCT(Model.RoiPercent)
            </div>
            <div class="res-kpi-label">Yıllık ROI</div>
        </div>
    </div>
</div>

<div class="summary-grid">
    <div class="card fiz-card res-section">
        <div class="card-header">
            <div class="fiz-card-header">
                <div class="fiz-ix">01</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yatırım Dağılımı</h2>
                    <div class="fiz-sub">Toplam sermaye harcaması</div>
                </div>
                <div class="fiz-card-tools">
                    <button type="button" class="fiz-collapse-btn" onclick="resToggleCard(this)">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body collapse-body">
            @if (Model.StationUnitCostTl > 0)
            {
                <div class="res-row"><span class="rl">Araç Şarj İstasyonu</span><span class="rv"><span class="js-money" data-tl="@RAW(Model.StationUnitCostTl)" data-dec="0">@N0(Model.StationUnitCostTl) ₺</span></span></div>
            }
            <div class="res-row"><span class="rl">Yer Sağlayıcı Giriş Bedeli</span><span class="rv"><span class="js-money" data-tl="@RAW(Model.ProviderEntryFeeTl)" data-dec="0">@N0(Model.ProviderEntryFeeTl) ₺</span></span></div>
            <div class="res-row"><span class="rl">Altyapı Yatırımı</span><span class="rv"><span class="js-money" data-tl="@RAW(Model.InfrastructureCostTl)" data-dec="0">@N0(Model.InfrastructureCostTl) ₺</span></span></div>
            <div class="res-row"><span class="rl">Cihaz + Lokasyon</span><span class="rv"><span class="js-money" data-tl="@RAW(Model.DeviceTotalTl)" data-dec="0">@N0(Model.DeviceTotalTl) ₺</span></span></div>
            <div class="res-row total"><span class="rl">Toplam Yatırım</span><span class="rv"><span class="js-money" data-tl="@RAW(Model.TotalInvestmentTl)" data-dec="0">@N0(Model.TotalInvestmentTl) ₺</span></span></div>
            @if (Model.ContractStartDate.HasValue)
            {
                <div class="res-row"><span class="rl">Sözleşme Başlangıç Tarihi</span><span class="rv">@Model.ContractStartDate.Value.ToString("dd.MM.yyyy", tr)</span></div>
            }
            @if (Model.ContractMonths > 0)
            {
                <div class="res-row"><span class="rl">Sözleşme Süresi</span><span class="rv">@Model.ContractMonths ay</span></div>
            }
            @if (Model.MonthlyLostDaysPercent > 0)
            {
                <div class="res-row"><span class="rl">Aylık Kayıp Gün</span><span class="rv">% @Model.MonthlyLostDaysPercent.ToString("0.#")</span></div>
            }
        </div>
    </div>

    <div class="card fiz-card res-section">
        <div class="card-header">
            <div class="fiz-card-header">
                <div class="fiz-ix">02</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yıllık Sabit Giderler &amp; Parametreler</h2>
                    <div class="fiz-sub">Kur, enflasyon ve gider kalemleri</div>
                </div>
                <div class="fiz-card-tools">
                    <button type="button" class="fiz-collapse-btn" onclick="resToggleCard(this)">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body collapse-body">
            <div class="res-row"><span class="rl">USD/TL Kuru</span><span class="rv">@N2(Model.UsdRate)</span></div>
            <div class="res-row"><span class="rl">TL Enflasyonu</span><span class="rv">%@N2(Model.InflationTl)</span></div>
            <div class="res-row"><span class="rl">USD Enflasyonu</span><span class="rv">%@N2(Model.InflationUsd)</span></div>
            @if (Model.HasRent)
            {
                <div class="res-row"><span class="rl">Yıllık Kira</span><span class="rv neg"><span class="js-money" data-tl="@RAW(-Model.AnnualRentTl)" data-dec="0">-@N0(Model.AnnualRentTl) ₺</span></span></div>
            }
            @if (Model.AnnualMaintenanceTl > 0)
            {
                <div class="res-row"><span class="rl">Yıllık Bakım</span><span class="rv neg"><span class="js-money" data-tl="@RAW(-Model.AnnualMaintenanceTl)" data-dec="0">-@N0(Model.AnnualMaintenanceTl) ₺</span></span></div>
            }
            @if (Model.AnnualAdvertisingRevenueTl > 0)
            {
                <div class="res-row"><span class="rl">Yıllık Reklam Geliri</span><span class="rv pos"><span class="js-money" data-tl="@RAW(Model.AnnualAdvertisingRevenueTl)" data-dec="0">+@N0(Model.AnnualAdvertisingRevenueTl) ₺</span></span></div>
            }
            @if (Model.HasLoan && Model.AnnualLoanPaymentTl > 0)
            {
                <div class="res-row"><span class="rl">Yıllık Kredi Ödemesi (@Model.LoanTermMonths ay)</span><span class="rv neg"><span class="js-money" data-tl="@RAW(-Model.AnnualLoanPaymentTl)" data-dec="0">-@N0(Model.AnnualLoanPaymentTl) ₺</span></span></div>
            }
            <div class="res-row total"><span class="rl">Yıl 1 Net Kâr</span>
                <span class="rv @(pos(Model.AnnualNetProfitTl) ? "pos" : "neg")"><span class="js-money" data-tl="@RAW(Model.AnnualNetProfitTl)" data-dec="0">@sign(Model.AnnualNetProfitTl)@N0(Model.AnnualNetProfitTl) ₺</span></span>
            </div>
        </div>
    </div>
</div>

@if (Model.YearSummaries.Any())
{
    <div class="card fiz-card res-section">
        <div class="card-header">
            <div class="fiz-card-header">
                <div class="fiz-ix">
                    <span class="material-symbols-outlined" style="font-size:18px;">show_chart</span>
                </div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yatırım Geri Dönüş (ROİ) Eğrisi</h2>
                    <div class="fiz-sub">Kümülatif nakit akışı — yatırımla negatiften başlar, başabaş (amorti) noktasında sıfır çizgisini geçerek kâra döner.</div>
                </div>
                <div class="fiz-card-tools">
                    <button type="button" class="fiz-collapse-btn" onclick="resToggleCard(this)">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="roi-chart-body collapse-body">
            <div class="roi-legend">
                <span class="roi-lg"><i class="roi-sw neg"></i> Zarar bölgesi</span>
                <span class="roi-lg"><i class="roi-sw pos"></i> Kâr bölgesi</span>
                <span class="roi-lg"><i class="roi-sw be"></i> Başabaş</span>
            </div>
            <div class="roi-chart-wrap" id="roiWrap">
                <svg id="roiSvg" class="roi-svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="ROİ geri dönüş eğrisi"></svg>
                <div class="roi-tip" id="roiTip" style="display:none;"></div>
            </div>
        </div>
    </div>
}

@if (Model.YearSummaries.Any())
{
    <div class="card fiz-card res-section">
        <div class="card-header">
            <div class="fiz-card-header">
                <div class="fiz-ix">03</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yıllık Nakit Akışı Projeksiyonu</h2>
                    <div class="fiz-sub">15 yıllık net kâr ve kümülatif denge</div>
                </div>
                <div class="fiz-card-tools">
                    <button type="button" class="fiz-collapse-btn" onclick="resToggleCard(this)">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="table-wrapper collapse-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Yıl</th>
                        <th class="text-right">Brüt Ciro</th>
                        <th class="text-right">Elektrik</th>
                        <th class="text-right">Komisyon</th>
                        <th class="text-right">Sabit Gider</th>
                        <th class="text-right">Net Kâr</th>
                        <th class="text-right">USD/TL</th>
                        <th class="text-right">Kümülatif Net Kâr</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.YearSummaries)
                    {
                        <tr>
                            <td><strong>@r.Year</strong></td>
                            <td class="text-right c-pos"><span class="js-money" data-tl="@RAW(r.TotalRevenueTl)" data-rate="@RAW(r.UsdRate)" data-dec="0">@N0(r.TotalRevenueTl) ₺</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-r.TotalElectricityCostTl)" data-rate="@RAW(r.UsdRate)" data-dec="0">-@N0(r.TotalElectricityCostTl) ₺</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-r.TotalCommissionTl)" data-rate="@RAW(r.UsdRate)" data-dec="0">-@N0(r.TotalCommissionTl) ₺</span></td>
                            <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-r.FixedCostsTl)" data-rate="@RAW(r.UsdRate)" data-dec="0">-@N0(r.FixedCostsTl) ₺</span></td>
                            <td class="text-right @(pos(r.NetProfitTl) ? "c-pos" : "c-neg")"><span class="js-money" data-tl="@RAW(r.NetProfitTl)" data-rate="@RAW(r.UsdRate)" data-dec="0">@sign(r.NetProfitTl)@N0(r.NetProfitTl) ₺</span></td>
                            <td class="text-right c-neu">@N2(r.UsdRate)</td>
                            <td class="text-right @(pos(r.CumulativeBalanceUsd) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(r.CumulativeBalanceUsd)" data-dec="0">@sign(r.CumulativeBalanceUsd)@USD(r.CumulativeBalanceUsd)</span></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @{
                        var tRevU  = Model.YearSummaries.Sum(r => r.UsdRate > 0 ? r.TotalRevenueTl         / r.UsdRate : 0m);
                        var tElecU = Model.YearSummaries.Sum(r => r.UsdRate > 0 ? r.TotalElectricityCostTl / r.UsdRate : 0m);
                        var tCommU = Model.YearSummaries.Sum(r => r.UsdRate > 0 ? r.TotalCommissionTl      / r.UsdRate : 0m);
                        var tFixU  = Model.YearSummaries.Sum(r => r.UsdRate > 0 ? r.FixedCostsTl           / r.UsdRate : 0m);
                        var tNetU  = Model.YearSummaries.Sum(r => r.UsdRate > 0 ? r.NetProfitTl            / r.UsdRate : 0m);
                        var tCumU  = Model.YearSummaries.Last().CumulativeBalanceUsd;
                    }
                    <tr class="tfoot-row">
                        <td>Toplam</td>
                        <td class="text-right c-pos"><span class="js-money" data-usd="@RAW(tRevU)" data-dec="0">@USD(tRevU)</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-usd="@RAW(-tElecU)" data-dec="0">-@USD(tElecU)</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-usd="@RAW(-tCommU)" data-dec="0">-@USD(tCommU)</span></td>
                        <td class="text-right c-neg"><span class="js-money" data-usd="@RAW(-tFixU)" data-dec="0">-@USD(tFixU)</span></td>
                        <td class="text-right @(pos(tNetU) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(tNetU)" data-dec="0">@sign(tNetU)@USD(tNetU)</span></td>
                        <td class="text-right">—</td>
                        <td class="text-right @(pos(tCumU) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(tCumU)" data-dec="0">@sign(tCumU)@USD(tCumU)</span></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@if (Model.SunkAmortization.Any())
{
    <div class="card fiz-card res-section">
        <div class="card-header">
            <div class="fiz-card-header">
                <div class="fiz-ix">
                    <span class="material-symbols-outlined" style="font-size:18px;">restore</span>
                </div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;">Yatırım Geri Kazanım (Amorti) Süresi</h2>
                    <div class="fiz-sub">
                        Şarj istasyonu donanımı taşınabilir olduğundan amortismana dahil edilmez; yalnızca geri kazanılamayan masraflar dikkate alınır.
                        @if (Model.SunkPaybackYears > 0)
                        {
                            <span style="font-weight:600;color:var(--success);margin-left:6px;">· Gömülü yatırım amorti süresi: @Model.SunkPaybackYears.ToString("0.0", tr) Yıl</span>
                        }
                    </div>
                </div>
                <div class="fiz-card-tools">
                    <button type="button" class="fiz-collapse-btn" onclick="resToggleCard(this)">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body collapse-body">
            <div class="res-row">
                <span class="rl">Taşınabilir Yatırım (Şarj İstasyonu) — amortismana dahil değil</span>
                <span class="rv" style="display:flex;flex-direction:column;align-items:flex-end;gap:2px;">
                    @if (Model.RecoverableInvestmentUsd > 0)
                    {
                        <span><span class="js-money" data-usd="@RAW(Model.RecoverableInvestmentUsd)" data-dec="0">@USD(Model.RecoverableInvestmentUsd)</span></span>
                        <span style="font-size:11px;color:var(--text-muted);">Amorti gerekmez — donanım taşınabilir</span>
                    }
                    else
                    {
                        <span style="color:var(--text-muted);">—</span>
                        <span style="font-size:11px;color:var(--text-muted);">İstasyon bedeli girilmedi</span>
                    }
                </span>
            </div>
            <div class="res-row">
                <span class="rl">Geri Kazanılacak (Gömülü) Yatırım</span>
                <span class="rv neg"><span class="js-money" data-usd="@RAW(Model.SunkInvestmentUsd)" data-dec="0">@USD(Model.SunkInvestmentUsd)</span></span>
            </div>
            <div class="res-row total">
                <span class="rl">Amorti Süresi (Gömülü Yatırım)</span>
                <span class="rv @(Model.SunkPaybackYears > 0 ? "pos" : "neg")">
                    @(Model.SunkPaybackYears > 0 ? Model.SunkPaybackYears.ToString("0.0", tr) + " Yıl" : "Sözleşme süresinde amorti edilemiyor")
                </span>
            </div>
        </div>
        <div class="table-wrapper collapse-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Yıl</th>
                        <th class="text-right">Yıllık Net Kâr (USD)</th>
                        <th class="text-right">Kümülatif Geri Kazanım (USD)</th>
                        <th class="text-right">Kalan Gömülü Maliyet (USD)</th>
                        <th class="text-center">Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.SunkAmortization)
                    {
                        <tr class="@(r.IsPaybackYear ? "tfoot-row" : "")">
                            <td><strong>@r.Year</strong></td>
                            <td class="text-right @(pos(r.NetProfitUsd) ? "c-pos" : "c-neg")"><span class="js-money" data-usd="@RAW(r.NetProfitUsd)" data-dec="0">@sign(r.NetProfitUsd)@USD(r.NetProfitUsd)</span></td>
                            <td class="text-right c-neu"><span class="js-money" data-usd="@RAW(r.RecoveredCumulativeUsd)" data-dec="0">@USD(r.RecoveredCumulativeUsd)</span></td>
                            <td class="text-right @(r.RemainingUsd > 0 ? "c-neg" : "c-pos")"><span class="js-money" data-usd="@RAW(r.RemainingUsd)" data-dec="0">@USD(r.RemainingUsd)</span></td>
                            <td class="text-center">
                                @if (r.IsPaybackYear)
                                {
                                    <span class="hat-badge" style="background:var(--success-50);color:var(--success);">✓ Amorti edildi</span>
                                }
                                else if (r.RemainingUsd <= 0)
                                {
                                    <span class="c-pos">Geçti</span>
                                }
                                else
                                {
                                    <span class="c-neu">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{ int lineNo = 4; }
@foreach (var line in Model.DeviceLines)
{
    <div class="card fiz-card res-section">
        <div class="card-header">
            <div class="fiz-card-header">
                <div class="fiz-ix">@lineNo.ToString("00")</div>
                <div>
                    <h2 style="font-size:14px;font-weight:600;margin:0;display:flex;align-items:center;gap:8px;">
                        <span class="hat-badge">@line.DeviceType</span>
                        İstasyon Hattı — @line.DeviceCount Cihaz · @line.SocketCount Soket · @line.AgreementGenre (@((line.AgreementRate * 100).ToString("0.#", tr))%)
                    </h2>
                    <div class="fiz-sub">Hat yatırımı: <span class="js-money" data-tl="@RAW(line.LineInvestmentTl)" data-dec="0">@N0(line.LineInvestmentTl) ₺</span> · Yıl 1 net marj: <span class="@(pos(line.AnnualNetMarginTl) ? "c-pos" : "c-neg")"><span class="js-money" data-tl="@RAW(line.AnnualNetMarginTl)" data-dec="0">@sign(line.AnnualNetMarginTl)@N0(line.AnnualNetMarginTl) ₺</span></span></div>
                </div>
                <div class="fiz-card-tools">
                    <button type="button" class="fiz-collapse-btn" onclick="resToggleCard(this)">
                        <span class="material-symbols-outlined">expand_more</span>
                    </button>
                </div>
            </div>
        </div>
        @if (line.YearProjections.Any())
        {
            <div class="table-wrapper collapse-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Yıl</th>
                            <th class="text-right">Şarj/Soket</th>
                            <th class="text-right">Yıllık Ciro</th>
                            <th class="text-right">Elektrik</th>
                            <th class="text-right">Komisyon</th>
                            <th class="text-right">Brüt Marj</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in line.YearProjections)
                        {
                            var margin = p.AnnualRevenueTl - p.AnnualElectricityCostTl - p.AnnualCommissionTl;
                            <tr>
                                <td><strong>@p.Year</strong></td>
                                <td class="text-right">@N2(p.DailyChargePerSocket)</td>
                                <td class="text-right c-pos"><span class="js-money" data-tl="@RAW(p.AnnualRevenueTl)" data-rate="@RAW(p.UsdRate)" data-dec="0">@N0(p.AnnualRevenueTl) ₺</span></td>
                                <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-p.AnnualElectricityCostTl)" data-rate="@RAW(p.UsdRate)" data-dec="0">-@N0(p.AnnualElectricityCostTl) ₺</span></td>
                                <td class="text-right c-neg"><span class="js-money" data-tl="@RAW(-p.AnnualCommissionTl)" data-rate="@RAW(p.UsdRate)" data-dec="0">-@N0(p.AnnualCommissionTl) ₺</span></td>
                                <td class="text-right @(pos(margin) ? "c-pos" : "c-neg")"><span class="js-money" data-tl="@RAW(margin)" data-rate="@RAW(p.UsdRate)" data-dec="0">@sign(margin)@N0(margin) ₺</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
    lineNo++;
}


