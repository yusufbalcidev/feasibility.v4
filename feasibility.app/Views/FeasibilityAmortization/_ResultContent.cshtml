<script>
    function resToggleCard(el) {
        var card = el.closest('.fiz-card') || el.closest('.card');
        if (card) card.classList.toggle('collapsed');
    }

    function resDownloadPdf() {
        window.print();
    }

    function mbSelectYear(sel) {
        var base = sel.getAttribute('data-target');
        var block = sel.closest('.mb-block');
        block.querySelectorAll('.mb-year').forEach(function (el) { el.style.display = 'none'; });
        var show = document.getElementById(base + '-' + sel.value);
        if (show) show.style.display = '';
    }

    (function () {
        var FXR = { TRY: 1, USD: 0, EUR: 0 };
        var SYM = { TRY: '₺', USD: '$', EUR: '€' };
        var CUR = 'USD';
        var BASE_USD_RATE = @RAW(Model.UsdRate);

        function fmt(n, dec) {
            return new Intl.NumberFormat('tr-TR', {
                minimumFractionDigits: dec, maximumFractionDigits: dec
            }).format(n);
        }

        function renderMoney() {
            var cur = CUR;
            var sym = SYM[cur];
            var baseUsd = BASE_USD_RATE > 0 ? BASE_USD_RATE : (FXR.USD || 0);
            if (cur === 'USD' && baseUsd <= 0) return;
            if (cur === 'EUR' && (baseUsd <= 0 || (FXR.USD || 0) <= 0 || (FXR.EUR || 0) <= 0)) return;
            document.querySelectorAll('.js-money').forEach(function (el) {
                var dec = parseInt(el.getAttribute('data-dec') || '0', 10);
                var aTl = el.getAttribute('data-tl');
                var tl, usd;
                if (aTl !== null) {
                    tl = parseFloat(aTl);
                    if (isNaN(tl)) return;
                    var pr = parseFloat(el.getAttribute('data-rate'));
                    var rate = (!isNaN(pr) && pr > 0) ? pr : baseUsd;
                    usd = rate > 0 ? tl / rate : 0;
                } else {
                    usd = parseFloat(el.getAttribute('data-usd'));
                    if (isNaN(usd)) return;
                    tl = usd * baseUsd;
                }
                var val;
                if (cur === 'TRY')      val = tl;
                else if (cur === 'USD') val = usd;
                else                    val = (FXR.USD > 0 && FXR.EUR > 0) ? usd * FXR.USD / FXR.EUR : 0;
                var neg = val < 0, abs = Math.abs(val);
                if (cur !== 'TRY') {
                    if (dec < 2) dec = 2;
                    if (abs > 0) {
                        var needed = Math.ceil(-Math.log10(abs)) + 1;
                        if (needed > dec) dec = Math.min(needed, 6);
                    }
                }
                var body = (cur === 'TRY') ? (fmt(abs, dec) + ' ' + sym) : (sym + ' ' + fmt(abs, dec));
                el.textContent = (neg ? '-' : '') + body;
            });
        }

        function applyRates(d) {
            if (d && d.usdSell > 0) FXR.USD = d.usdSell;
            if (d && d.eurSell > 0) FXR.EUR = d.eurSell;
        }

        window.fizSelectCurrency = function (sel) {
            CUR = sel.value;
            document.querySelectorAll('.fiz-cur-select').forEach(function (s) { s.value = CUR; });
            renderMoney();
        };

        document.addEventListener('DOMContentLoaded', function () {
            renderMoney();
            fetch('/FeasibilityAmortization/GetRates')
                .then(function (r) { return r.json(); })
                .then(function (d) { applyRates(d); renderMoney(); })
                .catch(function () { });
        });

        if (document.readyState !== 'loading') {
            renderMoney();
            fetch('/FeasibilityAmortization/GetRates')
                .then(function (r) { return r.json(); })
                .then(function (d) { applyRates(d); renderMoney(); })
                .catch(function () {});
        }
    })();
</script>

@if (Model.YearSummaries.Any())
{
    var roiParts = new List<string>();
    roiParts.Add("{l:\"Başlangıç\",v:" + RAW(-Model.EquityInvestmentUsd) + "}");
    foreach (var r in Model.YearSummaries)
    {
        roiParts.Add("{l:\"" + r.Year + "\",v:" + RAW(r.CumulativeBalanceUsd) + "}");
    }
    var roiJson = "[" + string.Join(",", roiParts) + "]";

    <script>
    (function () {
        var ROI_BASE = @Html.Raw(roiJson);
        if (!ROI_BASE || !ROI_BASE.length) return;

        var NS  = 'http://www.w3.org/2000/svg';
        var FXR = { USD: 0, EUR: 0 };
        var LAYOUT = null;
        var hoverBound = false;

        function mk(name, attrs, style) {
            var e = document.createElementNS(NS, name);
            for (var k in attrs) e.setAttribute(k, attrs[k]);
            if (style) e.setAttribute('style', style);
            return e;
        }
        function curNow() {
            var s = document.querySelector('.fiz-cur-select');
            return s ? s.value : 'USD';
        }
        function conv(usd) {
            var c = curNow();
            if (c === 'TRY') return FXR.USD > 0 ? usd * FXR.USD : usd;
            if (c === 'EUR') return (FXR.USD > 0 && FXR.EUR > 0) ? usd * FXR.USD / FXR.EUR : usd;
            return usd;
        }
        function sym() {
            var c = curNow();
            if (c === 'TRY') return FXR.USD > 0 ? '₺' : '$';
            if (c === 'EUR') return (FXR.USD > 0 && FXR.EUR > 0) ? '€' : '$';
            return '$';
        }
        function fmtFull(v) { return new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 }).format(v); }
        function fmtShort(v) {
            var a = Math.abs(v), s = v < 0 ? '-' : '';
            if (a >= 1e9) return s + (a / 1e9).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + ' Mr';
            if (a >= 1e6) return s + (a / 1e6).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + ' M';
            if (a >= 1e3) return s + (a / 1e3).toLocaleString('tr-TR', { maximumFractionDigits: 0 }) + ' B';
            return s + Math.round(a);
        }

        function draw() {
            var svg = document.getElementById('roiSvg');
            if (!svg) return;
            while (svg.firstChild) svg.removeChild(svg.firstChild);

            var W = 860, H = 360, padL = 66, padR = 28, padT = 28, padB = 52;
            var plotW = W - padL - padR, plotH = H - padT - padB;
            svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

            var pts = ROI_BASE.map(function (p) { return { l: p.l, v: conv(p.v) }; });
            var n = pts.length;
            var vals = pts.map(function (p) { return p.v; }).concat(0);
            var dMin = Math.min.apply(null, vals), dMax = Math.max.apply(null, vals);
            if (dMin === dMax) dMax = dMin + 1;
            var room = (dMax - dMin) * 0.10;
            var minV = dMin - room, maxV = dMax + room;

            function X(i) { return padL + (n === 1 ? 0 : (i / (n - 1)) * plotW); }
            function Y(v) { return padT + (maxV - v) / (maxV - minV) * plotH; }
            var yZero = Y(0);

            var zeroOff = Math.max(0, Math.min(1, (yZero - padT) / plotH));
            var defs = mk('defs', {});
            function grad(id, aTop, aBot) {
                var g = mk('linearGradient', { id: id, x1: 0, y1: padT, x2: 0, y2: padT + plotH, gradientUnits: 'userSpaceOnUse' });
                g.appendChild(mk('stop', { offset: 0 },       'stop-color:var(--success);stop-opacity:' + aTop));
                g.appendChild(mk('stop', { offset: zeroOff }, 'stop-color:var(--success);stop-opacity:' + aTop));
                g.appendChild(mk('stop', { offset: zeroOff }, 'stop-color:var(--danger);stop-opacity:' + aBot));
                g.appendChild(mk('stop', { offset: 1 },       'stop-color:var(--danger);stop-opacity:' + aBot));
                return g;
            }
            defs.appendChild(grad('roiFill', 0.30, 0.22));
            defs.appendChild(grad('roiLine', 1, 1));
            svg.appendChild(defs);

            var ticks = 4;
            for (var t = 0; t <= ticks; t++) {
                var gv = minV + (maxV - minV) * t / ticks, gy = Y(gv);
                svg.appendChild(mk('line', { x1: padL, y1: gy, x2: W - padR, y2: gy, 'stroke-dasharray': '3 4' }, 'stroke:var(--border);stroke-width:1;opacity:.7'));
                var yl = mk('text', { x: padL - 10, y: gy + 4, 'text-anchor': 'end', 'font-size': 11 }, 'fill:var(--text-muted)');
                yl.textContent = fmtShort(gv);
                svg.appendChild(yl);
            }

            svg.appendChild(mk('line', { x1: padL, y1: yZero, x2: W - padR, y2: yZero, 'stroke-dasharray': '5 4' }, 'stroke:var(--text-muted);stroke-width:1.4;opacity:.85'));

            var dArea = 'M ' + X(0) + ' ' + Y(pts[0].v);
            for (var i = 1; i < n; i++) dArea += ' L ' + X(i) + ' ' + Y(pts[i].v);
            dArea += ' L ' + X(n - 1) + ' ' + yZero + ' L ' + X(0) + ' ' + yZero + ' Z';
            svg.appendChild(mk('path', { d: dArea, fill: 'url(#roiFill)' }, 'stroke:none'));

            var dLine = 'M ' + X(0) + ' ' + Y(pts[0].v);
            for (var j = 1; j < n; j++) dLine += ' L ' + X(j) + ' ' + Y(pts[j].v);
            svg.appendChild(mk('path', { d: dLine, fill: 'none', stroke: 'url(#roiLine)', 'stroke-width': 2.6, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));

            var beIdx = -1;
            for (var b = 0; b < n; b++) { if (pts[b].v >= 0) { beIdx = b; break; } }
            if (beIdx > 0) {
                var bx = X(beIdx);
                svg.appendChild(mk('line', { x1: bx, y1: padT, x2: bx, y2: H - padB, 'stroke-dasharray': '4 4' }, 'stroke:var(--success);stroke-width:1;opacity:.6'));
                var anch = bx > W - 96 ? 'end' : (bx < padL + 96 ? 'start' : 'middle');
                var flag = mk('text', { x: bx, y: padT - 9, 'text-anchor': anch, 'font-size': 11.5, 'font-weight': 700 }, 'fill:var(--success)');
                flag.textContent = '★ Amorti yılı: ' + pts[beIdx].l;
                svg.appendChild(flag);
            } else if (beIdx === -1) {
                var note = mk('text', { x: W - padR, y: padT - 9, 'text-anchor': 'end', 'font-size': 11.5, 'font-weight': 700 }, 'fill:var(--danger)');
                note.textContent = 'Sözleşme süresinde amorti edilemiyor';
                svg.appendChild(note);
            }

            var layoutPts = [];
            for (var k = 0; k < n; k++) {
                var px = X(k), py = Y(pts[k].v);
                var posv = pts[k].v >= 0;
                if (k === beIdx) {
                    svg.appendChild(mk('circle', { cx: px, cy: py, r: 6.5 }, 'fill:var(--surface);stroke:var(--success);stroke-width:3'));
                } else {
                    svg.appendChild(mk('circle', { cx: px, cy: py, r: 3.2 }, 'fill:' + (posv ? 'var(--success)' : 'var(--danger)') + ';stroke:var(--surface);stroke-width:1.5'));
                }
                var xl = mk('text', { x: px, y: H - padB + 18, 'text-anchor': 'middle', 'font-size': 10 }, 'fill:var(--text-muted)');
                xl.textContent = pts[k].l;
                svg.appendChild(xl);
                layoutPts.push({ x: px, y: py, l: pts[k].l, v: pts[k].v });
            }

            svg.appendChild(mk('line', { id: 'roiHL', y1: padT, y2: H - padB, opacity: 0, 'stroke-dasharray': '4 3', 'pointer-events': 'none' }, 'stroke:var(--primary);stroke-width:1'));
            svg.appendChild(mk('circle', { id: 'roiHD', r: 5.5, opacity: 0, 'pointer-events': 'none' }, 'fill:var(--primary);stroke:var(--surface);stroke-width:2'));

            LAYOUT = { points: layoutPts, W: W, H: H };
            setupHover();
        }

        function tipHtml(idx, p) {
            var yr  = idx === 0 ? 'Başlangıç · Yatırım' : ('Yıl ' + p.l);
            var sgn = p.v > 0 ? '+' : (p.v < 0 ? '-' : '');
            var sm  = sym(), num = fmtFull(Math.abs(p.v));
            var body = sm === '₺' ? (num + ' ' + sm) : (sm + ' ' + num);
            return '<div class="roi-tip-yr">' + yr + '</div>' +
                   '<div class="roi-tip-val" style="color:' + (p.v >= 0 ? 'var(--success)' : 'var(--danger)') + '">' + sgn + body + '</div>' +
                   '<div class="roi-tip-sub">Kümülatif nakit akışı</div>';
        }

        function setupHover() {
            if (hoverBound) return;
            var svg = document.getElementById('roiSvg');
            var tip = document.getElementById('roiTip');
            if (!svg || !tip) return;
            svg.addEventListener('mousemove', function (ev) {
                if (!LAYOUT) return;
                var rect = svg.getBoundingClientRect();
                if (!rect.width) return;
                var vx = (ev.clientX - rect.left) / rect.width * LAYOUT.W;
                var best = 0, bd = Infinity;
                for (var i = 0; i < LAYOUT.points.length; i++) {
                    var dd = Math.abs(LAYOUT.points[i].x - vx);
                    if (dd < bd) { bd = dd; best = i; }
                }
                var p  = LAYOUT.points[best];
                var hl = document.getElementById('roiHL'), hd = document.getElementById('roiHD');
                if (hl) { hl.setAttribute('x1', p.x); hl.setAttribute('x2', p.x); hl.setAttribute('opacity', 0.45); }
                if (hd) { hd.setAttribute('cx', p.x); hd.setAttribute('cy', p.y); hd.setAttribute('opacity', 1); }
                tip.innerHTML = tipHtml(best, p);
                tip.style.display = 'block';
                tip.style.left = (p.x / LAYOUT.W * rect.width) + 'px';
                tip.style.top  = (p.y / LAYOUT.H * rect.height) + 'px';
            });
            svg.addEventListener('mouseleave', function () {
                tip.style.display = 'none';
                var hl = document.getElementById('roiHL'), hd = document.getElementById('roiHD');
                if (hl) hl.setAttribute('opacity', 0);
                if (hd) hd.setAttribute('opacity', 0);
            });
            hoverBound = true;
        }

        function ensureRates(cb) {
            if (FXR.USD > 0) { cb(); return; }
            fetch('/FeasibilityAmortization/GetRates')
                .then(function (r) { return r.json(); })
                .then(function (d) { if (d) { if (d.usdSell > 0) FXR.USD = d.usdSell; if (d.eurSell > 0) FXR.EUR = d.eurSell; } cb(); })
                .catch(function () { cb(); });
        }

        ensureRates(draw);

        var _origCur = window.fizSelectCurrency;
        window.fizSelectCurrency = function (sel) {
            if (typeof _origCur === 'function') _origCur(sel);
            ensureRates(draw);
        };
    })();
    </script>
}
