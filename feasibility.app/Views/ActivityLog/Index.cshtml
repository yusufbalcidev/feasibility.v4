@model PagedResult<ActivityLogListDto>
@{
    ViewData["Title"] = "Aktivite Logları";
    Layout = "~/Views/Shared/_BaseLayout.cshtml";

    // Controller adını okunabilir Türkçe modül adına çevirir.
    string SayfaAdi(string? controller) => controller switch
    {
        "FeasibilityAmortization" => "Fizibilite",
        "Feasibility"             => "Fizibilite",
        "Study"                   => "Çalışma",
        "Location"                => "Lokasyon",
        "LocationTypeMaintenance" => "Lokasyon Tipi",
        "User"                    => "Kullanıcı",
        "Role"                    => "Rol",
        "Login"                   => "Oturum",
        "Dashboard"               => "Panel",
        "ActivityLog"             => "Aktivite Logları",
        null or ""                => "-",
        _                         => controller
    };

    // Controller action adını okunabilir Türkçe aksiyona çevirir.
    string AksiyonAdi(string? action) => action switch
    {
        "Index"          => "Listeleme",
        "Details" or "View" => "Görüntüleme",
        "Create"         => "Ekleme",
        "Edit" or "Update" => "Güncelleme",
        "Save"           => "Kaydetme",
        "Delete"         => "Silme",
        "Restore"        => "Geri Alma",
        "Calculate" or "CalcTest" => "Hesaplama",
        "Logout"         => "Çıkış",
        "ForgotPassword" => "Şifremi Unuttum",
        "ResetPassword"  => "Şifre Sıfırlama",
        "VerifyCode"     => "Kod Doğrulama",
        "ResendCode"     => "Kod Tekrar Gönderme",
        "AccessDenied"   => "Erişim Reddi",
        null or ""       => "-",
        _                => action
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/activitylog/index/style.css" />
}

<div class="page-header">
    <div>
        <h1>Aktivite Logları</h1>
        <p>Sistemdeki veri değiştiren işlemlerin kaydı (middleware tabanlı). GET istekleri kaydedilmez.</p>
    </div>
</div>

<div class="card">
    <div class="card-header list-toolbar">
        @await Html.PartialAsync("_SearchBar", Model.Search, new ViewDataDictionary(ViewData) { { "Placeholder", "Kullanıcı, sayfa, IP veya tip ara..." } })
        <span class="badge badge-info">@Model.TotalCount kayıt (son 500 içinden)</span>
    </div>
    <div class="table-wrapper">
        <table class="table activity-table">
            <thead>
                <tr>
                    <th>Tarih &amp; Saat</th>
                    <th>Kullanıcı</th>
                    <th>İşlem</th>
                    <th>Fizibilite</th>
                    <th>Tür</th>
                    <th class="th-center">Durum</th>
                    <th class="th-center">Süre</th>
                    <th class="th-right">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8"><div class="empty-state"><span class="material-symbols-outlined">history</span>@(string.IsNullOrWhiteSpace(Model.Search) ? "Henüz kayıt bulunmuyor." : $"\"{Model.Search}\" için sonuç bulunamadı.")</div></td></tr>
                }
                @foreach (var log in Model.Items)
                {
                    var local = log.CreatedAt.ToLocalTime();
                    <tr>
                        <td class="cell-date">
                            <span class="cell-primary">@local.ToString("dd.MM.yyyy")</span>
                            <span class="cell-meta">@local.ToString("HH:mm:ss")</span>
                        </td>
                        <td class="cell-user">
                            <span class="cell-primary">@(string.IsNullOrEmpty(log.UserName) ? "Anonim" : log.UserName)</span>
                            <span class="cell-meta">@(log.IpAddress ?? "-")</span>
                        </td>
                        <td class="cell-op">
                            <span class="cell-primary">
                                <span class="http-tag http-@log.HttpMethod.ToLowerInvariant()">@log.HttpMethod</span>
                                @AksiyonAdi(log.Action)
                            </span>
                            <span class="cell-meta">@SayfaAdi(log.Controller)</span>
                        </td>
                        <td>
                            @if (log.StudyId.HasValue)
                            {
                                <a href="/FeasibilityAmortization/View/@log.StudyId" class="study-link">
                                    <span class="material-symbols-outlined">calculate</span>
                                    @(string.IsNullOrEmpty(log.StudyName) ? log.StudyId.Value.ToString()[..8] + "…" : log.StudyName)
                                </a>
                            }
                            else { <span class="cell-empty">—</span> }
                        </td>
                        <td>
                            @{
                                var (actionLabel, actionBadgeClass) = log.ActionType switch
                                {
                                    "Create"        => ("Ekledi",          "badge-active"),
                                    "Update"        => ("Güncelledi",      "badge-info"),
                                    "Delete"        => ("Sildi",           "badge-passive"),
                                    "Login"         => ("Giriş Yaptı",     "badge-active"),
                                    "Logout"        => ("Çıkış Yaptı",     "badge-info"),
                                    "LoginFailed"   => ("Giriş Başarısız", "badge-warning"),
                                    "PasswordReset" => ("Şifre Sıfırladı", "badge-info"),
                                    "Error"         => ("Hata",            "badge-passive"),
                                    _               => (log.ActionType,    "badge-info")
                                };
                            }
                            <span class="badge @actionBadgeClass">@actionLabel</span>
                        </td>
                        <td class="th-center">
                            @{
                                var statusClass = log.StatusCode switch
                                {
                                    >= 500 => "badge-passive",
                                    >= 400 => "badge-warning",
                                    >= 300 => "badge-info",
                                    _ => "badge-active"
                                };
                            }
                            <span class="badge @statusClass">@log.StatusCode</span>
                        </td>
                        <td class="th-center cell-duration">@log.ElapsedMs<span class="unit">ms</span></td>
                        <td class="th-right">
                            <a asp-action="Details" asp-route-id="@log.Id" class="row-action-btn">
                                <span class="material-symbols-outlined">visibility</span> Görüntüle
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="@((IPagedResult)Model)" />
</div>
